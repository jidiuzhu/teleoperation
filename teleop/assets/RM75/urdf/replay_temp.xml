    <mesh name="link_2"   content_type="model/stl" file="../../RM75/urdf/RM75-6F/urdf/link_2.STL"/>
    <mesh name="link_3"   content_type="model/stl" file="../../RM75/urdf/RM75-6F/urdf/link_3.STL"/>
    <mesh name="link_4"   content_type="model/stl" file="../../RM75/urdf/RM75-6F/urdf/link_4.STL"/>
