    <mesh name="right_hand_ring_tip"           file="../../xhand_right/meshes/right_hand_ring_tip.STL" />
    <mesh name="right_hand_pinky_link1"        file="../../xhand_right/meshes/right_hand_pinky_link1.STL" />
    <mesh name="right_hand_pinkyback_link1"    file="../../xhand_right/meshes/right_hand_pinkyback_link1.STL" />
    <mesh name="right_hand_pinky_link2"        file="../../xhand_right/meshes/right_hand_pinky_link2.STL" />
    <mesh name="right_hand_pinkyback_link2"    file="../../xhand_right/meshes/right_hand_pinkyback_link2.STL" />
    <mesh name="right_hand_pinky_tip"          file="../../xhand_right/meshes/right_hand_pinky_tip.STL" />

    <mesh name="base_link" content_type="model/stl" file="../../RM75/urdf/RM75-6F/urdf/base_link.STL"/>
