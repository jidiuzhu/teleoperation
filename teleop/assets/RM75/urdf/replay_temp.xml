                        quat="0.999101 0.0421927 0.00270285 0.00294856"
                        mass="1.11"
                        diaginertia="0.0018367 0.00150201 0.00105938"/>
              <joint name="joint_3" pos="0 0 0" axis="0 0 1" range="-3.106 3.106" actuatorfrcrange="-30 30"/>
              <geom type="mesh" rgba="1 1 1 1" mesh="link_3"/>

              <body name="link_4" quat="0.707105 -0.707108 0 0">
                <inertial pos="-5e-06 -0.084658 0.004747"
                          quat="0.432821 0.552209 -0.561126 0.439168"
                          mass="0.685"
                          diaginertia="0.00131346 0.00128244 0.000315738"/>
                <joint name="joint_4" pos="0 0 0" axis="0 0 1" range="-2.356 2.356" actuatorfrcrange="-30 30" damping="2.0"/>
                <geom type="mesh" rgba="1 1 1 1" mesh="link_4"/>

                <body name="link_5" pos="0 -0.21 0" quat="0.707105 0.707108 0 0">
                  <inertial pos="7.8e-05 -0.012937 -0.008781"
                            quat="0.995304 0.096364 0.00225001 0.00888711"
                            mass="0.619"
                            diaginertia="0.000627369 0.000549264 0.000363449"/>
                  <joint name="joint_5" pos="0 0 0" axis="0 0 1" range="-3.106 3.106" actuatorfrcrange="-10 10"/>
                  <geom type="mesh" rgba="1 1 1 1" mesh="link_5"/>

                  <body name="link_6" quat="0.707105 -0.707108 0 0">
                    <inertial pos="-1.4e-05 -0.078524 0.002819"
                              quat="0.430179 0.5452 -0.565052 0.445442"
                              mass="0.602"
                              diaginertia="0.000792852 0.000780759 0.000261092"/>
                    <joint name="joint_6" pos="0 0 0" axis="0 0 1" range="-2.234 2.234" actuatorfrcrange="-10 10" damping="2.0"/>
                    <geom type="mesh" rgba="1 1 1 1" mesh="link_6"/>

                    <body name="link_7" pos="0 -0.1725 0" quat="0.707105 0.707108 0 0">
                      <inertial pos="0.001094 -7.7e-05 -0.010119"
                                quat="0.505029 0.501976 -0.49846 0.494473"
                                mass="0.144"
                                diaginertia="6.54492e-05 4.41192e-05 3.50775e-05"/>
                      <joint name="joint_7" pos="0 0 0" axis="0 0 1" range="-6.28 6.28" actuatorfrcrange="-10 10"/>
                      <geom type="mesh" rgba="1 1 1 1" mesh="link_7"/>
                      <body name="hand_mount" pos="0 0 0" quat="1 0 0 0">
                        <site name="right_hand_imu" size="0.01" pos="0 0 0" euler="0 0 0"/>
                        <camera name="wrist_cam" pos="0.07 0 0.06" euler="0 -1.57 -1.57" fovy="120"/>
                        <body name="hand_root" euler="0 0 0">
                            <include file="../../xhand_right/xhand_right_model.xml"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
    </body> 

    <light directional="false" ambient="0.2 0.2 0.2" diffuse="0.2 0.2 0.2"
           specular="0 0 0" castshadow="false" pos="0 0 0" dir="0 0 -1" name="light0"/>
  </worldbody>

  
  <actuator>
    <position name="rm75_j1_pos" joint="joint_1" kp="50000" ctrlrange="-3.14 3.14"/>
    <position name="rm75_j2_pos" joint="joint_2" kp="5000" ctrlrange="-2.27 2.27"/>
    <position name="rm75_j3_pos" joint="joint_3" kp="5000" ctrlrange="-3.14 3.14"/>
    <position name="rm75_j4_pos" joint="joint_4" kp="5000" ctrlrange="-2.36 2.36"/>
    <position name="rm75_j5_pos" joint="joint_5" kp="5000" ctrlrange="-3.14 3.14"/>
    <position name="rm75_j6_pos" joint="joint_6" kp="5000" ctrlrange="-2.23 2.23"/>
    <position name="rm75_j7_pos" joint="joint_7" kp="3000" ctrlrange="-6.28 6.28"/>

    <position name="right_hand_thumb_bend_joint" joint="right_hand_thumb_bend_joint" ctrllimited="true" ctrlrange="0 1.83" kp="100"/>
    <position name="right_hand_thumb_rota_joint1" joint="right_hand_thumb_rota_joint1" ctrllimited="true" ctrlrange="-0.698 1.57" kp="100"/>
    <position name="right_hand_thumb_rota_joint2" joint="right_hand_thumb_rota_joint2" ctrllimited="true" ctrlrange="0 1.57" kp="100"/>

    <position name="right_hand_index_bend_joint" joint="right_hand_index_bend_joint" ctrllimited="true" ctrlrange="-0.174 0.174" kp="100"/>
    <position name="right_hand_index_joint1" joint="right_hand_index_joint1" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>
    <position name="right_hand_index_joint2" joint="right_hand_index_joint2" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>

    <position name="right_hand_mid_joint1" joint="right_hand_mid_joint1" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>
    <position name="right_hand_mid_joint2" joint="right_hand_mid_joint2" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>

    <position name="right_hand_ring_joint1" joint="right_hand_ring_joint1" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>
    <position name="right_hand_ring_joint2" joint="right_hand_ring_joint2" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>

    <position name="right_hand_pinky_joint1" joint="right_hand_pinky_joint1" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>
    <position name="right_hand_pinky_joint2" joint="right_hand_pinky_joint2" ctrllimited="true" ctrlrange="0 1.92" kp="100"/>
  </actuator>
    
</mujoco>
