    <mesh name="link_7"   content_type="model/stl" file="../../RM75/urdf/RM75-6F/urdf/link_7.STL"/>

  </asset>

  <worldbody>
    <geom condim="3" group="1" material="floorplane" name="floor"
          pos="0 0 0" size="1 1 .125" type="plane"/>



    <body name="rm75_base" pos="-0.4 -0.1 0.0" quat="1 0 0 0">
        <geom type="mesh" rgba="0.8 0.8 0.8 1" mesh="base_link"/>
        <body name="link_1" pos="0 0 0.2405">
          <inertial pos="0.000241 -0.013273 -0.00995"
                    quat="0.994748 0.0977096 0.00152589 0.0304335"
                    mass="1.574"
                    diaginertia="0.00248814 0.00235608 0.00141495"/>
          <joint name="joint_1" pos="0 0 0" axis="0 0 1" range="-3.106 3.106"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="link_1"/>

          <body name="link_2" quat="0.707105 -0.707108 0 0">
            <inertial pos="-0.000357 -0.106789 0.005329"
                      quat="0.42567 0.528808 -0.571708 0.460778"
                      mass="1.217"
                      diaginertia="0.00357183 0.00349364 0.000765446"/>
            <joint name="joint_2" pos="0 0 0" axis="0 0 1" range="-2.2689 2.2689" damping="2.0"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="link_2"/>

            <body name="link_3" pos="0 -0.256 0" quat="0.707105 0.707108 0 0">
