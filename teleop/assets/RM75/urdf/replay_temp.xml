<mujoco>
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" iterations="60">
    <flag warmstart="enable"/>
  </option>

  <default>
    <geom condim="6" contype="1" conaffinity="1" friction="0.8 0.1 0.1" solimp="0.95 0.99 0.001" solref="0.001 1" />
    <joint type="hinge" damping="0.5" armature="0.01" />
    <default class="visualgeom">
        <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
    <default class="hand_collision">
        <geom condim="6" contype="1" conaffinity="2"/>
    </default>
  </default>

  <asset>
    <texture file="../../textures/light-gray-plaster.png" type="2d" name="texplane"/>
    <material name="floorplane" reflectance="0.01" shininess="0.0" specular="0.0"
              texrepeat="2 2" texture="texplane" texuniform="true"/>
    <material name="visualgeom" rgba="0.7 0.7 0.7 1"/>
    <material name="obj_mat" rgba="0.85 0.9 0.95 1"/>
    
    <mesh name="right_hand_link"               file="../../xhand_right/meshes/right_hand_link.STL" />
    <mesh name="right_hand_ee_link"            file="../../xhand_right/meshes/right_hand_ee_link.STL" />
    <mesh name="right_hand_back_link"          file="../../xhand_right/meshes/right_hand_back_link.STL" />
    <mesh name="right_hand_thumb_bend_link"    file="../../xhand_right/meshes/right_hand_thumb_bend_link.STL" />
    <mesh name="right_hand_thumb_rota_link1"   file="../../xhand_right/meshes/right_hand_thumb_rota_link1.STL" />
    <mesh name="right_hand_thumb_rotaback_link1" file="../../xhand_right/meshes/right_hand_thumb_rotaback_link1.STL" />
    <mesh name="right_hand_thumb_rota_link2"   file="../../xhand_right/meshes/right_hand_thumb_rota_link2.STL" />
    <mesh name="right_hand_thumb_rotaback_link2" file="../../xhand_right/meshes/right_hand_thumb_rotaback_link2.STL" />
    <mesh name="right_hand_thumb_rota_tip"     file="../../xhand_right/meshes/right_hand_thumb_rota_tip.STL" />
    <mesh name="right_hand_index_bend_link"    file="../../xhand_right/meshes/right_hand_index_bend_link.STL" />
    <mesh name="right_hand_index_rota_link1"   file="../../xhand_right/meshes/right_hand_index_rota_link1.STL" />
    <mesh name="right_hand_index_rotaback_link1" file="../../xhand_right/meshes/right_hand_index_rotaback_link1.STL" />
    <mesh name="right_hand_index_rota_link2"   file="../../xhand_right/meshes/right_hand_index_rota_link2.STL" />
    <mesh name="right_hand_index_rotaback_link2" file="../../xhand_right/meshes/right_hand_index_rotaback_link2.STL" />
    <mesh name="right_hand_index_rota_tip"     file="../../xhand_right/meshes/right_hand_index_rota_tip.STL" />
    <mesh name="right_hand_mid_link1"          file="../../xhand_right/meshes/right_hand_mid_link1.STL" />
    <mesh name="right_hand_midback_link1"      file="../../xhand_right/meshes/right_hand_midback_link1.STL" />
    <mesh name="right_hand_mid_link2"          file="../../xhand_right/meshes/right_hand_mid_link2.STL" />
    <mesh name="right_hand_midback_link2"      file="../../xhand_right/meshes/right_hand_midback_link2.STL" />
    <mesh name="right_hand_mid_tip"            file="../../xhand_right/meshes/right_hand_mid_tip.STL" />
    <mesh name="right_hand_ring_link1"         file="../../xhand_right/meshes/right_hand_ring_link1.STL" />
    <mesh name="right_hand_ringback_link1"     file="../../xhand_right/meshes/right_hand_ringback_link1.STL" />
